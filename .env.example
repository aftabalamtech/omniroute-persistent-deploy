# OmniRoute official release runtime
DATA_DIR=/app/data
PORT=20128
HOSTNAME=0.0.0.0

# Persistence wrapper
GITHUB_BACKUP_ENABLED=true
GITHUB_BACKUP_REPO=YOUR_GITHUB_USERNAME/omniroute-backup
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_FILE=latest.db.zst
GITHUB_TOKEN=
BACKUP_INTERVAL_MINUTES=10
OMNIROUTE_DB_FILENAME=storage.sqlite

# Set the official OmniRoute application secrets and provider variables here.
# Never commit real secrets. See the pinned upstream release documentation:
# https://github.com/diegosouzapw/OmniRoute/tree/v3.8.50
