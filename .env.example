# OmniRoute official release runtime
DATA_DIR=/app/data
PORT=10000
HOSTNAME=0.0.0.0
NODE_ENV=production
OMNIROUTE_DB_FILENAME=storage.sqlite

# Stable application secrets; preserve existing values during migration.
JWT_SECRET=<stable-secret>
API_KEY_SECRET=<stable-secret>
STORAGE_ENCRYPTION_KEY=<existing-encryption-key>
STORAGE_ENCRYPTION_KEY_VERSION=v1
INITIAL_PASSWORD=<admin-password>

# External disaster recovery; keep the backup repository private.
GITHUB_BACKUP_ENABLED=true
GITHUB_BACKUP_REPO=aftabalamtech/omniroute-backup
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_FILE=latest.db.zst
GITHUB_TOKEN=<fine-grained-token-with-private-repo-contents-read-write>
BACKUP_INTERVAL_MINUTES=10
MAX_BACKUP_BYTES=94371840

# Optional OmniRoute functionality; not required for backup persistence.
# REDIS_URL=<Render Redis URL>

# Never commit real secrets. Configure them through Render's environment UI.
